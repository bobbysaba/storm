# list of files/directories to NOT commit to the git repo

# broker certificates and keys: your own (certs/), NSSL team ones
# (providers/nssl/certs/team/), and the old NSSL location (aws/)
/certs/
/providers/nssl/certs/team/
/aws/

# a group's own code providers (providers/<name>/) stay out of the repo;
# only NSSL's ships
/providers/*
!/providers/__init__.py
!/providers/nssl/

# mbtiles files (too large for git — download separately or build locally)
tiles/*.mbtiles

# claude details 
.claude/
CLAUDE.md 

# python cache 
__pycache__/
*.pyc
*.pyo

# ignore the DS_Store stuff
.DS_Store

# build artifacts
STORM.app
*.iconset/

# icon source and generator — dev only, icons committed directly
storm.png
scripts/create_icon.py

# no device-specific python env files
*.egg-info/

# ignore the data used to test the app 
*.log
veh_data/

# roadmap (is for local progress only)
roadmap.txt

# password management utility — not for repo
set_password.py

# locs/ source data — kept locally, not needed in repo
locs/merge_locs.py
locs/all_rounds052615.txt
locs/sites.info
locs/deployment_locations.json

# pip build output for the headless package
headless/build/

# performance logs and their zips (core/perf_log.py, scripts/collect_perf_logs.py)
perf_logs/

# storm tracks saved from archive TRACK (core/workspace.py): local work, one CSV per case date
storm_tracks/

# case packages (File > Export Case Package)
data/case_packages/
data/studio/

# generated by setup.py / scripts/create_desktop_entry.sh with machine-specific paths
storm_launcher.sh
scripts/launch_storm_linux.sh

# local secrets (API keys, broker password, admin passphrase hash): copy .env.example to .env
.env

# per-install settings: copy storm.example.toml (or a profiles/ file) to storm.toml
storm.toml

# broker traffic the recorder writes (archive/recorder.py)
/recordings/
