# Copy to .env (never commit .env). Real environment variables take precedence.

# MQTT broker passwords, when [mqtt] / [mqtt.viewer] in storm.toml set a username.
STORM_MQTT_PASSWORD=
STORM_MQTT_VIEWER_PASSWORD=

# NSSL API key, used with [providers.nssl] enabled = true: live CLAMPS
# soundings, SFCOA and the API fallback for archive data, and the regional
# mesonet [[sources]] in profiles/nssl.toml (OK/WTM/KS/CO/NE/SD). Request
# one from the STORM team.
NSSL_API_KEY=

# Keys for your own [[sources]] go here too, under the name their
# api_key_env gives (docs/data-sources.md), e.g.
# FARM_API_KEY=

# openRouteService key for turn-by-turn routing: https://openrouteservice.org
ORS_API_KEY=

# Admin mode only: pbkdf2-HMAC-SHA256 passphrase hash. Leave empty to disable.
STORM_ADMIN_PASSPHRASE_HASH=
